# Copy to infra/.env and fill in real values. Never commit the real .env.

# ngrok — used by the `ngrok` compose service to expose ve_reach's webhook
# publicly for Meta. Get an authtoken from https://dashboard.ngrok.com,
# and a reserved domain (free tier includes one static domain).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=https://your-reserved-domain.ngrok-free.dev
