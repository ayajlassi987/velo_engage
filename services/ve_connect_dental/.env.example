CLINIC_ID=clinic_alnoor_001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=velodb
DB_USER=velo
DB_PASSWORD=velo_secret

# 'mysql' for Phase A (direct read against your own self-hosted OpenDental
# instance) or 'api' for Phase B (OpenDental's REST API, once a Developer
# Key + a clinic's Customer Key exist). See README.md.
OPENDENTAL_TRANSPORT=mysql

# Phase A — direct MySQL access to a self-hosted OpenDental instance.
OPENDENTAL_DB_HOST=localhost
OPENDENTAL_DB_PORT=3306
OPENDENTAL_DB_NAME=opendental
OPENDENTAL_DB_USER=opendental
OPENDENTAL_DB_PASSWORD=

# Phase B — only needed once OPENDENTAL_TRANSPORT=api.
OPENDENTAL_API_BASE=
OPENDENTAL_DEVELOPER_KEY=
OPENDENTAL_CUSTOMER_KEY=
