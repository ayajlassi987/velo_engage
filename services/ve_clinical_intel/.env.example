# This service runs on the DGX Spark, not in the main docker-compose stack.
# Copy to .env and fill in real values — see PROJECT_STATUS.md Part A for
# how to confirm each of these.

CLINIC_ID=clinic_alnoor_001

# The team's model server (MedGemma), running on this same DGX. Confirmed
# real port: 8080 (docker compose service key is velodoc-ai).
MEDGEMMA_URL=http://localhost:8080

# NemoGuard content-safety NIM, also on this DGX.
NEMOGUARD_URL=http://localhost:8001

# The MAIN machine's reachable address — NOT localhost, since this service
# runs on a different physical machine. There is no direct route to raw
# Postgres from the DGX (no root there for a real VPN network interface),
# so all data access — reading clinical notes AND writing extraction
# results — goes through ve_connect's HTTP API only.
#
# Use the main machine's Tailscale IP here (run `tailscale ip -4` on that
# machine), not its LAN IP — router-level client isolation blocked direct
# LAN reachability in this deployment. Confirm reachability first:
#   curl http://<main-machine-tailscale-ip>:8003/health
VE_CONNECT_URL=http://<main-machine-tailscale-ip>:8003

# Only needed if the DGX has no root access to run Tailscale's normal
# TUN-based networking — its rootless userspace mode instead exposes a
# local HTTP proxy that outbound calls must be routed through explicitly.
# Leave unset if the DGX has a real Tailscale network interface.
# NO_PROXY matters here too: without it, httpx would also try to route the
# local MedGemma/NemoGuard calls above through this same proxy, which is
# unnecessary and makes purely-local calls depend on the proxy being up.
# HTTP_PROXY=http://localhost:1055
# HTTPS_PROXY=http://localhost:1055
# NO_PROXY=localhost,127.0.0.1
